# Compat-sync scratch file: the agent writes a one-line PR title here; the PR
# driver (scripts/open-compat-sync-pr.ts) reads it then deletes it before
# committing. Ignored as a safeguard so it can never land in a PR.
.compat-sync-pr-title.txt
# Generated TypeDoc API documentation (regenerated on demand)
lab/public/api-docs/
lab/public/lite/api-docs/

# Kenney asset source GLBs (CC0) - bake outputs are committed under lab/public
scratch/
# Waterfall demo: the raw ~72 MB photogrammetry scan + its bake are the SOURCE the shipped
# rock.glb is optimised from (lab/public/waterfall/scripts/optimize-rock.ts). Kept on disk so the model
# can be re-exported at another triangle budget, but far too big to commit — and deliberately
# not staged into the demo bundle either (see copyDemoRuntimeAssets).
lab/public/waterfall/rock-high.glb
lab/public/waterfall/rock-heightmap-high.bin
# Same story for the oasis: `oasis.glb` is the un-tiled island the shipped `oasis-<tier>.glb` are
# derived from, and `oasis-heightmap.bin` is a bake of it that the scene never reads (the fluid
# collides with the ROCK's height map alone — the oasis is set dressing). 6.7 MB of build-time
# intermediates, kept on disk for re-exports and likewise skipped by copyDemoRuntimeAssets.
lab/public/waterfall/oasis.glb
lab/public/waterfall/oasis-heightmap.bin
lab/public/aquanova/*.hdr
# Skybox cube faces (~4.5 MB of PNG). Public domain (Space 3D, Unlicense — see ASSET-LICENSES.md),
# so this is a size decision only: committing them would not make a fresh clone runnable anyway,
# because ship.glb above is ignored too.
lab/public/aquanova/skybox/
# Local SMAA comparison/oracle workbench; intentionally excluded from the shipping feature.
lab/lite/smaa-lab.html
lab/lite/src/smaa-lab.ts
lab/lite/src/smaa-pipelines.ts
scripts/smaa-oracle-luts.ts
lab/public/smaa-ref/
scripts/smaa-ref/
playwright-report/
lab/public/littlest-tokyo/CREDITS.txt

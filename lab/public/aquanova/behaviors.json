  "behaviors": {
    "dynamic": {
      "label": "Dynamic body",
      "description": "Makes the owner a movable rigid body.",
      "eventsRaised": [],
      "properties": {
        "dynamic": {
          "type": "constant",
          "value": true,
          "label": "Dynamic"
        },
        "mass": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 10,
          "label": "Mass (kg)"
        },
        "lockedRotationAxes": {
          "type": "array",
          "items": {
            "type": "enum",
            "values": [
              "x",
              "y",
              "z"
            ]
          },
          "label": "Locked rotation axes",
          "description": "Prevents the rigid body from rotating around the selected local axes."
        }
      }
    },
    "liquefaction": {
      "label": "Liquefaction",
      "description": "Allows a configured fluid simulation to liquefy the owner.",
      "eventsRaised": [
        {
          "name": "startLiquefaction"
        },
        {
          "name": "cancelLiquefaction"
        },
        {
          "name": "endLiquefaction"
        }
      ],
      "properties": {
        "liquefiable": {
          "type": "constant",
          "value": true,
          "label": "Liquefiable",
          "definition": false
        },
        "fluidSim": {
          "type": "array",
          "items": {
            "type": "string",
            "optionsSource": "Fluid Simulations"
          },
          "label": "Fluid simulations"
        },
        "electrifiable": {
          "type": "boolean",
          "default": false,
          "label": "Electrifiable",
          "description": "Allows the resulting liquid domain to retain electrical charge."
        },
        "linked": {
          "type": "array",
          "items": {
            "type": "entity",
            "optionsSource": "nearbyEntities"
          },
          "definition": false,
          "label": "Linked entities",
          "description": "Entities that melt and recover as one group with this owner."
        },
        "sound": {
          "type": "string",
          "optionsSource": "soundCategories",
          "label": "Splash sound category",
          "description": "One of the categories the Liquefactor weapon defines.",
          "emptyHint": "No categories yet - give the Liquefactor weapon its sound categories first."
        }
      }
    },
    "probeExcluded": {
      "label": "Exclude from reflections",
      "description": "Excludes the owner from generated local environment probes.",
      "eventsRaised": [],
      "properties": {
        "reflectionProbe": {
          "type": "constant",
          "value": "exclude",
          "label": "Reflection probe"
        }
      }
    },
    "player": {
      "label": "Player",
      "description": "Configures the first-person player start and controller.",
      "eventsRaised": [
        {
          "name": "electricalContact"
        },
        {
          "name": "electricalContactEnded"
        }
      ],
      "properties": {
        "direction": {
          "type": "vector3",
          "label": "Facing direction"
        },
        "characterStrength": {
          "type": "number",
          "minimum": 0,
          "default": 10000,
          "label": "Push strength"
        },
        "maxGrabDistance": {
          "type": "number",
          "minimum": 0.01,
          "default": 8,
          "label": "Maximum grab distance"
        },
        "maxHeldObjectDistance": {
          "type": "number",
          "minimum": 0.01,
          "default": 8,
          "label": "Maximum held-object distance"
        },
        "submergedParticleCount": {
          "type": "number",
          "minimum": 1,
          "default": 100,
          "label": "Submerged particle count",
          "description": "Visible particles above the player's head required to consider the player submerged."
        },
        "electrifiedParticleCount": {
          "type": "number",
          "integer": true,
          "minimum": 1,
          "default": 8,
          "label": "Electrified particle count",
          "description": "Electrified particle centres inside the live player capsule required to enter electrical contact."
        }
      }
    },
    "weaponLiquefactor": {
      "label": "Liquefactor weapon",
      "description": "Configures the Liquefactor weapon and its sound categories.",
      "eventsRaised": [
        {
          "name": "startLiquefaction"
        },
        {
          "name": "cancelLiquefaction"
        },
        {
          "name": "endLiquefaction"
        }
      ],
      "properties": {
        "range": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 100,
          "label": "Beam range"
        },
        "sounds": {
          "type": "record",
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "optionsSource": "Sound List"
            }
          },
          "keyLabel": "Category",
          "label": "Sound categories",
          "description": "Names the categories a liquefiable element may ask for, and the MP3s each one picks from."
        }
      }
    },
    "pickEntity": {
      "label": "Pick up entity",
      "description": "Rotates and collects the owner when the player intersects it.",
      "eventsRaised": [
        {
          "property": "raiseEvent.event"
        }
      ],
      "properties": {
        "boundingBoxScale": {
          "type": "vector3",
          "minimum": 0,
          "default": [
            1,
            1,
            1
          ],
          "label": "Pickup bounds scale"
        },
        "raiseEvent": {
          "type": "object",
          "label": "Event to raise",
          "properties": {
            "target": {
              "type": "entity",
              "optionsSource": "eventEntities",
              "label": "Target",
              "description": "Defaults to the behavior owner."
            },
            "event": {
              "type": "event",
              "optionsSource": "events",
              "allowNew": true,
              "required": true,
              "label": "Event"
            }
          }
        },
        "sound": {
          "type": "string",
          "optionsSource": "Sound List",
          "default": "pickItem",
          "label": "Sound"
        },
        "rotationAxis": {
          "type": "enum",
          "values": [
            "x",
            "y",
            "z"
          ],
          "default": "y",
          "label": "Rotation axis",
          "description": "Local owner axis used for the pickup's idle rotation."
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 1,
          "label": "Rotation speed"
        }
      }
    },
    "enableEntity": {
      "extends": "entityAction",
      "label": "Enable entity",
      "eventsRaised": [
        {
          "name": "enable"
        }
      ]
    },
    "disableEntity": {
      "extends": "entityAction",
      "label": "Disable entity",
      "eventsRaised": [
        {
          "name": "disable"
        }
      ]
    },
    "showEntity": {
      "extends": "entityAction",
      "label": "Show entity",
      "eventsRaised": [
        {
          "name": "show"
        }
      ]
    },
    "hideEntity": {
      "extends": "entityAction",
      "label": "Hide entity",
      "eventsRaised": [
        {
          "name": "hide"
        }
      ]
    },
    "removeEntity": {
      "extends": "entityAction",
      "label": "Remove entity",
      "eventsRaised": [
        {
          "name": "remove"
        }
      ]
    },
    "enableCollision": {
      "extends": "entityAction",
      "label": "Enable collision",
      "eventsRaised": [
        {
          "name": "enableCollision"
        }
      ]
    },
    "disableCollision": {
      "extends": "entityAction",
      "label": "Disable collision",
      "eventsRaised": [
        {
          "name": "disableCollision"
        },
        {
          "name": "disableFluidSimulationCollision"
        }
      ],
      "properties": {
        "fluidSimulationOnly": {
          "type": "boolean",
          "default": false,
          "label": "Fluid simulation only",
          "description": "Keep physics and weapon collision enabled, but exclude this entity from every fluid simulation collision field."
        }
      }
    },
    "playAnimation": {
      "label": "Play animation",
      "description": "Plays an animation targeting the owner.",
      "eventsRaised": [],
      "properties": {
        "animation": {
          "type": "string",
          "optionsSource": "animations",
          "allowNew": true,
          "label": "Animation name",
          "description": "Defaults to the first animation targeting the owner.",
          "emptyHint": "The clips are read off the element this rides, so a behaviour in the library - which has no owner yet - has to name one."
        },
        "loop": {
          "type": "boolean",
          "default": true,
          "label": "Loop"
        }
      }
    },
    "sound": {
      "label": "Sound",
      "description": "Runs one or more independently triggered sound actions.",
      "eventsRaised": [],
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "label": "Hearing radius (m)",
          "description": "Volume falls linearly with player distance and reaches zero at this radius. Zero disables distance attenuation."
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "required": true,
          "label": "Sound actions",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "enum",
                "values": [
                  "play",
                  "stop"
                ],
                "default": "play",
                "required": true,
                "label": "Action"
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "label": "Event subscriptions",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "entitySource",
                      "optionsSource": "eventEntities",
                      "required": true,
                      "label": "Sources",
                      "description": "Whose events are watched. One source is written as a string; several are written as an array."
                    },
                    "name": {
                      "type": "event",
                      "optionsSource": "eventsOfSources",
                      "optionsFrom": "source",
                      "required": true,
                      "label": "Event",
                      "description": "Only the events every one of the sources raises can be chosen.",
                      "emptyHint": "Choose the sources first - this offers what they all raise."
                    }
                  }
                }
              },
              "id": {
                "type": "string",
                "required": true,
                "when": {
                  "property": "action",
                  "values": [
                    "play"
                  ]
                },
                "label": "Sound ID",
                "description": "Globally unique playback channel ID referenced by stop actions."
              },
              "sound": {
                "type": "string",
                "optionsSource": "Sound List",
                "required": true,
                "when": {
                  "property": "action",
                  "values": [
                    "play"
                  ]
                },
                "label": "Sound"
              },
              "soundId": {
                "type": "string",
                "optionsSource": "soundIds",
                "optionsByChunk": "soundIdsByChunk",
                "required": true,
                "when": {
                  "property": "action",
                  "values": [
                    "stop"
                  ]
                },
                "label": "Sound ID",
                "description": "Playback channel defined by a sound play action."
              },
              "delay": {
                "type": "number",
                "minimum": 0,
                "default": 0,
                "label": "Delay (s)"
              },
              "fade": {
                "type": "number",
                "minimum": 0,
                "default": 0,
                "label": "Fade (s)",
                "description": "Fade-in duration for play, or fade-out duration for stop."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1,
                "when": {
                  "property": "action",
                  "values": [
                    "play"
                  ]
                },
                "label": "Volume"
              },
              "loop": {
                "type": "boolean",
                "default": false,
                "when": {
                  "property": "action",
                  "values": [
                    "play"
                  ]
                },
                "label": "Loop"
              }
            }
          }
        }
      }
    },
    "fluidSimulation": {
      "label": "Fluid simulation",
      "description": "Runs an authored fluid simulation at the owner's world position and maps external events to simulation, player-collision, emitter, and sink actions.",
      "eventsRaised": [
        {
          "name": "startSimulation"
        },
        {
          "name": "emissionComplete"
        },
        {
          "name": "endSimulation"
        }
      ],
      "properties": {
        "fluidSim": {
          "type": "string",
          "optionsSource": "Fluid Simulations",
          "required": true,
          "label": "Fluid simulation"
        },
        "electrifiable": {
          "type": "boolean",
          "default": false,
          "label": "Electrifiable",
          "description": "Allows this simulation's liquid domain to retain electrical charge."
        },
        "shutdownDuration": {
          "type": "number",
          "minimum": 0,
          "default": 10,
          "label": "Shutdown duration (s)"
        },
        "shutdownAlphaDecay": {
          "type": "number",
          "minimum": 0,
          "default": 2,
          "label": "Shutdown alpha decay (s)"
        },
        "eventActions": {
          "type": "array",
          "minItems": 1,
          "required": true,
          "label": "Event actions",
          "description": "External events that control the simulation, player collision, or one of its named flow objects.",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "entitySource",
                "optionsSource": "eventEntities",
                "required": true,
                "label": "Sources",
                "description": "Whose event is watched. One source is written as a string; several equivalent sources are written as an array."
              },
              "event": {
                "type": "event",
                "optionsSource": "eventsOfSources",
                "optionsFrom": "source",
                "required": true,
                "label": "Event",
                "emptyHint": "Choose at least one source first."
              },
              "action": {
                "type": "enum",
                "values": [
                  "enableSimulation",
                  "disableSimulation",
                  "pauseSimulation",
                  "unpauseSimulation",
                  "shutdownSimulation",
                  "enablePlayerCollision",
                  "disablePlayerCollision",
                  "enableEmitter",
                  "disableEmitter",
                  "enableSink",
                  "disableSink"
                ],
                "default": "enableSimulation",
                "required": true,
                "label": "Action"
              },
              "emitter": {
                "type": "string",
                "optionsSource": "fluidEmitters",
                "optionsFromRoot": "fluidSim",
                "required": true,
                "when": {
                  "property": "action",
                  "values": [
                    "enableEmitter",
                    "disableEmitter"
                  ]
                },
                "label": "Emitter",
                "emptyHint": "The selected fluid simulation has no named emitters."
              },
              "sink": {
                "type": "string",
                "optionsSource": "fluidSinks",
                "optionsFromRoot": "fluidSim",
                "required": true,
                "when": {
                  "property": "action",
                  "values": [
                    "enableSink",
                    "disableSink"
                  ]
                },
                "label": "Sink",
                "emptyHint": "The selected fluid simulation has no named sinks."
              }
            }
          }
        }
      }
    },
    "fluidElectrifier": {
      "label": "Fluid electrifier",
      "description": "Permanently electrifies an eligible liquid domain when enough particle centres enter the owner's world AABB.",
      "eventsRaised": [
        {
          "name": "fluidElectrified"

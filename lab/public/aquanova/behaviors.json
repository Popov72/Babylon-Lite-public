          "minimum": 1,
          "default": 24,
          "label": "Particle threshold"
        },
        "propagationSpeed": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 8,
          "label": "Propagation speed (m/s)"
        }
      }
    },
    "electricalDetonator": {
      "label": "Electrical detonator",
      "description": "Raises explode once enough propagated electrified particle centres enter the owner's world AABB.",
      "eventsRaised": [
        {
          "name": "explode"
        }
      ],
      "properties": {
        "particleThreshold": {
          "type": "number",
          "integer": true,
          "minimum": 1,
          "default": 4,
          "label": "Particle threshold"
        }
      }
    },
    "explode": {
      "label": "Explosion",
      "description": "Fractures and ejects nearby liquefiable and dynamic entities. Without explicit subscriptions, the owner's explode event triggers it once.",
      "eventsRaised": [],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "label": "Event subscriptions",
          "description": "Optional replacement triggers. When omitted, the behavior listens for the owner's explode event.",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "entitySource",
                "optionsSource": "eventEntities",
                "required": true,
                "label": "Sources",
                "description": "Whose events are watched. One source is written as a string; several are written as an array."
              },
              "name": {
                "type": "event",
                "optionsSource": "eventsOfSources",
                "optionsFrom": "source",
                "required": true,
                "label": "Event",
                "description": "Only the events every one of the sources raises can be chosen.",
                "emptyHint": "Choose the sources first - this offers what they all raise."
              }
            }
          }
        },
        "sound": {
          "type": "string",
          "optionsSource": "Sound List",
          "default": "bigExplosion",
          "label": "Sound"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 10,
          "label": "Radius (m)"
        },
        "fragmentCount": {
          "type": "number",
          "integer": true,
          "minimum": 2,
          "maximum": 32,
          "default": 8,
          "label": "Fragments per mesh"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 12,
          "label": "Debris speed (m/s)"
        },
        "debrisLifetime": {
          "type": "number",
          "minimum": 0,
          "default": 15,
          "label": "Visible lifetime (s)"
        },
        "fadeDuration": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "default": 2,
          "label": "Fade duration (s)"
        }
      }
    },
    "spark": {
      "label": "Sparks",
